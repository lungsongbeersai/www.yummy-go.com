{
  "name": "new-yummy-go",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "verify:node": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "dev:desktop": "concurrently -k -n NEXT,ELECTRON -c cyan,green \"next dev\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint .",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && electron .",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "electron:pack": "npm run electron:start && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/status-bar": "^8.0.2",
    "@deedarb/capacitor-tcp-socket": "^7.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/react": "^6.0.2",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.0",
    "i18next-http-backend": "^3.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.40.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.5.3",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.yummygo.pos",
    "productName": "Yummy Go POS",
    "files": [
      "dist-electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    }
  },
  "description": "Clean rebuild of the Yummy Go restaurant POS inside `New-yummy-go.com`.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lungsongbeersai/www.yummy-go.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lungsongbeersai/www.yummy-go.com/issues"
  },
  "homepage": "https://github.com/lungsongbeersai/www.yummy-go.com#readme"
}

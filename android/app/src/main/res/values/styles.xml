<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- App background หลัง splash -->
        <item name="android:windowBackground">#16a34a</item>
        <item name="android:statusBarColor">#16a34a</item>
        <item name="android:navigationBarColor">#16a34a</item>

        <!-- พื้นหลังเขียว ใช้ status bar icon สีขาว -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Main app theme หลังจาก splash หาย -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- ช่วง WebView โหลด จะไม่เห็นพื้นหลังขาว -->
        <item name="android:windowBackground">#16a34a</item>
        <item name="android:background">#16a34a</item>

        <item name="android:statusBarColor">#16a34a</item>
        <item name="android:navigationBarColor">#16a34a</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <!-- พื้นหลังเขียวเต็มจอ -->
    <item name="windowSplashScreenBackground">@color/splash_background</item>

    <!-- ใช้ icon กลางจอแบบ square ไม่บีบ -->
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>

    <!-- พื้นหลังหลัง icon -->
    <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>

    <!-- หลัง splash จบ เข้า theme หลัก -->
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

    <item name="android:forceDarkAllowed">false</item>
</style>

</resources>
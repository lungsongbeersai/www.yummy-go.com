<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme หลัก -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- ป้องกัน Android บังคับเปลี่ยนสี -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Theme สำหรับเลือกวันที่ -->
        <item name="android:datePickerDialogTheme">
            @style/YummyGoDatePickerDialog
        </item>

        <!-- Theme สำหรับเลือกเวลา -->
        <item name="android:timePickerDialogTheme">
            @style/YummyGoDatePickerDialog
        </item>
    </style>


    <!-- Theme หน้าหลักของ Capacitor -->
    <style name="AppTheme.NoActionBar"
        parent="Theme.AppCompat.Light.NoActionBar">

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- ล้าง android:background ที่ค้างมาจาก AppTheme.NoActionBarLaunch (@drawable/splash) —
             BridgeActivity เรียก setTheme() หลัง theme ของ activity ถูกสร้างไปแล้ว จึงเป็นการ
             applyStyle ทับ attribute เดิมเท่านั้น อะไรที่ theme นี้ไม่ได้กำหนดจะค้างค่าของ splash
             android:background ใน theme เป็นพื้นหลัง default ของทุก View รวมถึง popup ของระบบ
             (แถบ ตัด/คัดลอก และ selection handle ตอน long-press ช่อง input ใน WebView)
             ผลคือกล่องดำ/สี่เหลี่ยมดำรอบ handle เฉพาะในแอปนี้ -->
        <item name="android:background">@null</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="android:datePickerDialogTheme">
            @style/YummyGoDatePickerDialog
        </item>

        <item name="android:timePickerDialogTheme">
            @style/YummyGoDatePickerDialog
        </item>
    </style>


    <!-- Theme ของกล่องเลือกวันที่ -->
    <style name="YummyGoDatePickerDialog"
        parent="Theme.AppCompat.Light.Dialog.Alert">

        <!-- พื้นหลังให้เป็นสีขาว -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- สีของวันที่ที่เลือก -->
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>

        <!-- สีข้อความ -->
        <item name="android:textColorPrimary">#111827</item>
        <item name="android:textColorSecondary">#4B5563</item>

        <!-- สีปุ่มตกลงและยกเลิก -->
        <item name="buttonBarPositiveButtonStyle">
            @style/YummyGoDatePickerButton
        </item>

        <item name="buttonBarNegativeButtonStyle">
            @style/YummyGoDatePickerButton
        </item>

        <item name="buttonBarNeutralButtonStyle">
            @style/YummyGoDatePickerButton
        </item>
    </style>


    <!-- ปุ่มตกลงและยกเลิก -->
    <style name="YummyGoDatePickerButton"
        parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">

        <item name="android:textColor">@color/colorAccent</item>
    </style>


    <!-- Splash Screen -->
    <style name="AppTheme.NoActionBarLaunch"
        parent="Theme.SplashScreen">

        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>

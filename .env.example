# Backend API base URL (required)
NEXT_PUBLIC_BASE_URL=https://api.yummy-go.com

# Local printer agent — browser/agent receipt-printing path
NEXT_PUBLIC_PRINTER_AGENT_URL=http://127.0.0.1:7777
NEXT_PUBLIC_PRINTER_AGENT_SECRET=your-printer-agent-secret

# Optional overrides
# NEXT_PUBLIC_SOCKET_URL=      # Socket.IO server; defaults to NEXT_PUBLIC_API_URL, then NEXT_PUBLIC_BASE_URL
